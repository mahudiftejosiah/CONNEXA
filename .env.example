# ============================================================
# CONNEXA - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to source control.
# ============================================================

# Supabase Project URL (found in: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Public Key (found in: Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - never expose to browser)
# Used in server actions and API routes only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application URL (used for auth redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
